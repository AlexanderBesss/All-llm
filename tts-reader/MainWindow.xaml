<Window x:Class="TtsReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TtsReader.Models"
        Title="TTS Reader" Height="760" Width="1180" MinHeight="500" MinWidth="800"
        Background="{StaticResource WindowBackground}" Foreground="White">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:DocumentNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Foreground="#E8E8E8" ToolTip="{Binding FullPath}"/>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open folder..." Command="{Binding OpenFolderCommand}"/>
                    <Button Content="▶ Play from caret" Command="{Binding PlayCommand}"/>
                    <Button Content="■ Stop" Command="{Binding StopCommand}"/>
                    <Button Content="Settings..." Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
                <TextBlock x:Name="BackendLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource Accent}" Margin="12,0" TextAlignment="Right"
                           Text="{Binding BackendStatus}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Documents" FontWeight="SemiBold" Margin="3,2,3,8"/>
                    <TreeView x:Name="DocumentTree" ItemsSource="{Binding Documents}"
                              Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="DocumentTree_SelectedItemChanged"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#363A42"/>
            <RichTextBox x:Name="DocumentText" Grid.Column="2" IsReadOnly="True"
                         AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="16"
                         Padding="0" BorderThickness="0" Background="Transparent"
                         CaretBrush="{StaticResource Accent}" SelectionBrush="{StaticResource Accent}"
                         SelectionTextBrush="#15171B" SelectionOpacity="0.8"
                         SelectionChanged="DocumentText_SelectionChanged"
                         AutomationProperties.Name="Rendered document"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" Padding="10,7">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
