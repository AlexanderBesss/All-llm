<Window x:Class="TtsReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TtsReader.Models"
        Title="TTS Reader" Height="760" Width="1180" MinHeight="500" MinWidth="800"
        Background="{StaticResource WindowBackground}" Foreground="White">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:DocumentNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Foreground="#E8E8E8" ToolTip="{Binding FullPath}"/>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="OpenFolderButton" Content="Open folder..." Click="OpenFolder_Click"/>
                    <Button x:Name="PlayButton" Content="▶ Play from caret" Click="Play_Click"/>
                    <Button x:Name="StopButton" Content="■ Stop" Click="Stop_Click" IsEnabled="False"/>
                    <Button Content="Settings..." Click="Settings_Click"/>
                </StackPanel>
                <TextBlock x:Name="BackendLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource Accent}" Margin="12,0" TextAlignment="Right"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Documents" FontWeight="SemiBold" Margin="3,2,3,8"/>
                    <TreeView x:Name="DocumentTree" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="DocumentTree_SelectedItemChanged"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#363A42"/>
            <TextBox x:Name="DocumentText" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True"
                     AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="16"
                     Padding="18" SelectionChanged="DocumentText_SelectionChanged"
                     AutomationProperties.Name="Document text"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" Padding="10,7">
            <TextBlock x:Name="StatusText" Text="Choose a folder to begin." TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
