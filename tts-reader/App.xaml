<Application x:Class="TtsReader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#15171B"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#202329"/>
        <SolidColorBrush x:Key="Accent" Color="#69B7FF"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#343941"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555B66"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E23"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#454A54"/>
        </Style>
    </Application.Resources>
</Application>
