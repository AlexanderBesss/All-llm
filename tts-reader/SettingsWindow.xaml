<Window x:Class="TtsReader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech settings"
        Height="620"
        Width="800"
        MinHeight="560"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="AvailabilityTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedAvailabilityTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource AvailabilityTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedBackend.IsAvailable}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SPEECH"/>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Speech settings"/>
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Margin="0,4,0,0"
                       Text="Choose a local speech backend and keep its source settings ready for playback."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Available backends"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,0"
                               Text="Select one to inspect its availability and local paths."/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Foreground="{StaticResource Accent}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedBackend.Name}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"/>
            </Grid>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Backends}"
                     SelectedItem="{Binding SelectedBackend, Mode=TwoWay}"
                     Background="{StaticResource PanelBackground}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Kind}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentSoft}"
                                        BorderBrush="{StaticResource Accent}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,3"
                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="ACTIVE"
                                               Foreground="{StaticResource AccentHover}"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Availability}"
                                           Style="{StaticResource AvailabilityTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource SurfaceCardStyle}"
                Padding="14"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="BACKEND CONFIGURATION"/>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Selected backend" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource SelectedAvailabilityTextStyle}"
                               Text="{Binding SelectedBackend.Availability}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Style="{StaticResource LabelTextStyle}"
                           Text="Piper executable"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding SelectedExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"
                         ToolTip="Path to piper.exe installed by piper-tts."/>

                <TextBlock Grid.Row="2"
                           Style="{StaticResource LabelTextStyle}"
                           Text="Piper ONNX model"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8"/>
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding SelectedModelPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"
                         ToolTip="Path to a Piper .onnx voice; its .onnx.json file must be beside it."/>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource LabelTextStyle}"
                           Text="Windows voice name"
                           VerticalAlignment="Center"
                           Margin="0,0,12,8"/>
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding SelectedVoice, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"
                         ToolTip="Leave blank to use the Windows default voice."/>

                <StackPanel Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Use selected backend"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ActivateCommand}"
                            ToolTip="Make this backend active for the current session"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Text="Save to persist this selection."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource InputBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    MinHeight="38">
                <TextBlock Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="{Binding Status}"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
