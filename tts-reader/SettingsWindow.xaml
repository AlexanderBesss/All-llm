<Window x:Class="TtsReader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech settings" Height="600" Width="800" MinHeight="520" MinWidth="680"
         WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Speech backends" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}"
                 Background="{StaticResource PanelBackground}" Foreground="White" BorderBrush="#454A54">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8" Width="650">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Kind}" Foreground="#B9BEC8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Availability}" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{Binding DownloadStatus}" Foreground="#B9BEC8" FontSize="11"/>
                            <ProgressBar Height="5" Width="120" Margin="0,3,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding DownloadProgress}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="⇩" FontSize="16" Padding="8,2"
                                ToolTip="Download this LLM backend"
                                Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,12,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ExecutableLabel}" VerticalAlignment="Center" Margin="0,0,10,8"
                       Visibility="{Binding ShowExecutable, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     Visibility="{Binding ShowExecutable, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SelectedExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Path to piper.exe, or to the venv python.exe used by this LLM engine."/>
            <TextBlock Grid.Row="1" Text="{Binding ModelLabel}" VerticalAlignment="Center" Margin="0,0,10,8"
                       Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SelectedModelPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Piper: path to a .onnx voice with its .onnx.json beside it. LLM: Hugging Face repo id or local model folder (downloaded on first run)."/>
            <TextBlock Grid.Row="2" Text="Engine variant" VerticalAlignment="Center" Margin="0,0,10,8"
                       Visibility="{Binding ShowVariant, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     Visibility="{Binding ShowVariant, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SelectedVariant, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Chatterbox: base, turbo, nano, or multilingual. Qwen3-TTS: custom-voice, voice-design, or voice-clone."/>
            <TextBlock Grid.Row="3" Text="Language" VerticalAlignment="Center" Margin="0,0,10,8"
                       Visibility="{Binding ShowLanguage, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     Visibility="{Binding ShowLanguage, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Language used for synthesis (for example English)."/>
            <TextBlock Grid.Row="4" Text="Instruction / reference text" VerticalAlignment="Center" Margin="0,0,10,8"
                       Visibility="{Binding ShowInstruct, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     Visibility="{Binding ShowInstruct, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SelectedInstruct, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Voice control instruction (custom voice) or reference transcript (voice clone)."/>
            <TextBlock Grid.Row="5" Text="{Binding VoiceLabel}" VerticalAlignment="Center" Margin="0,0,10,8"
                       Visibility="{Binding ShowVoice, Converter={StaticResource BoolToVis}}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     Visibility="{Binding ShowVoice, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SelectedVoice, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Windows: leave blank for the default voice. Chatterbox base/multilingual: optional reference .wav; Turbo/Nano: required reference .wav. Qwen3-TTS: speaker name, voice description, or reference .wav path."/>
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Button Content="Use selected backend" Command="{Binding ActivateCommand}"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="3">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Content="Save" IsDefault="True" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
