<Window x:Class="TtsReader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech settings" Height="560" Width="760" MinHeight="480" MinWidth="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" Foreground="White">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Speech backends" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ListBox x:Name="BackendList" Grid.Row="1" Background="{StaticResource PanelBackground}"
                 Foreground="White" BorderBrush="#454A54" SelectionChanged="BackendList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8" Width="650">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Backend.Kind}" Foreground="#B9BEC8"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Availability}" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,12,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Download source" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox x:Name="SourceText" Grid.Row="0" Grid.Column="1" Padding="7" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Windows voice name" VerticalAlignment="Center" Margin="0,0,10,8"/>
            <TextBox x:Name="VoiceText" Grid.Row="1" Grid.Column="1" Padding="7" Margin="0,0,0,8"
                     ToolTip="Leave blank to use the Windows default voice."/>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Button x:Name="ActivateButton" Content="Use selected backend" Click="Activate_Click"/>
                <Button x:Name="DownloadButton" Content="Download" Click="Download_Click"/>
                <ProgressBar x:Name="DownloadProgress" Width="180" Height="18" Margin="10,0" Minimum="0" Maximum="100"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Cancel" IsCancel="True"/>
                <Button Content="Save" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
