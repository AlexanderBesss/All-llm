{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "acceptanceCriteria", "risks", "files", "tests", "directImplementation", "subtasks"],
  "properties": {
    "summary": { "type": "string" },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "risks": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "directImplementation": { "type": "boolean" },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "description", "dependsOn", "files", "tests"],
        "properties": {
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
