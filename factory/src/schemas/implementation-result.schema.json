{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "committed", "pushed", "tests", "subtasks", "blockers"],
  "properties": {
    "summary": { "type": "string" },
    "committed": { "type": "boolean" },
    "pushed": { "type": "boolean" },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "output"],
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string" },
          "output": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "status"],
        "properties": {
          "summary": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
