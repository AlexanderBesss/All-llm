{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "summary", "description", "status", "issuetype", "labels", "parentKey", "projectKey", "sprint"],
        "properties": {
          "key": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "status": {
            "anyOf": [
              { "type": "string" },
              { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": false },
              { "type": "null" }
            ]
          },
          "issuetype": {
            "anyOf": [
              { "type": "string" },
              { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": false },
              { "type": "null" }
            ]
          },
          "labels": { "type": "array", "items": { "type": "string" } },
          "parentKey": {
            "anyOf": [
              { "type": "string" },
              { "type": "object", "required": ["key"], "properties": { "key": { "type": "string" } }, "additionalProperties": false },
              { "type": "null" }
            ]
          },
          "projectKey": {
            "anyOf": [
              { "type": "string" },
              { "type": "object", "required": ["key"], "properties": { "key": { "type": "string" } }, "additionalProperties": false },
              { "type": "null" }
            ]
          },
          "sprint": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name", "state", "boardId", "originBoardId", "startDate", "endDate", "completeDate", "goal"],
                  "properties": {
                    "id": { "type": ["integer", "string", "null"] },
                    "name": { "type": ["string", "null"] },
                    "state": { "type": ["string", "null"] },
                    "boardId": { "type": ["integer", "string", "null"] },
                    "originBoardId": { "type": ["integer", "string", "null"] },
                    "startDate": { "type": ["string", "null"] },
                    "endDate": { "type": ["string", "null"] },
                    "completeDate": { "type": ["string", "null"] },
                    "goal": { "type": ["string", "null"] }
                  },
                  "additionalProperties": false
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
