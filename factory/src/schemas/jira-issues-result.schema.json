{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "summary", "description", "status", "issuetype", "labels", "parentKey", "projectKey"],
        "properties": {
          "key": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string" },
          "issuetype": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "parentKey": { "type": "string" },
          "projectKey": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
