<Window x:Class="LlmServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LlmServerManager.Converters"
        Title="LLM Server Manager"
        Width="960" Height="720"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#CFCFCF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#CFCFCF"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2E5E3A"/>
            <Setter Property="BorderBrush" Value="#3E7C50"/>
            <Setter Property="Foreground" Value="#D7F5DF"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#5E2E2E"/>
            <Setter Property="BorderBrush" Value="#7C3E3E"/>
            <Setter Property="Foreground" Value="#F5D7D7"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="#252526" BorderBrush="#333333" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="18,8" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Starting...">
                    <Setter Property="Foreground" Value="#FFC107"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Console open (port not listening)">
                    <Setter Property="Foreground" Value="#FFC107"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="OptionTemplate">
            <Border Background="#252526" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                            <TextBlock Text="{Binding Badges}" FontSize="11" Foreground="#7AA2F7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#9E9E9E" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource StatusText}"/>
                        <Button Content="Start"
                                Style="{StaticResource StartButton}"
                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsStopped}"/>
                        <Button Content="Stop"
                                Style="{StaticResource StopButton}"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsRunning}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UpdateTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9E9E9E"/>
                <Button Content="Run"
                        Style="{StaticResource ModernButton}"
                        Padding="14,4"
                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsIdle}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#9E9E9E"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#252526" BorderBrush="#333333" BorderThickness="1,1,0,0" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse..."
                        Style="{StaticResource ModernButton}"
                        Padding="12,3"
                        Command="{Binding BrowseCommand}"
                        Visibility="{Binding IsRepoMissing, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#9E9E9E" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid Visibility="{Binding IsRepoMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="All-llm repository not found"
                               FontSize="20" FontWeight="SemiBold" Foreground="#E8E8E8"
                               HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#9E9E9E" TextAlignment="Center"
                               Text="The app looks for a folder containing llm-servers next to the executable (or in settings.json). Either run the app from inside the repo, or browse to the All-llm root folder."/>
                    <Button Content="Browse to All-llm root..."
                            Style="{StaticResource StartButton}"
                            HorizontalAlignment="Center" Margin="0,18,0,0"
                            Command="{Binding BrowseCommand}"/>
                </StackPanel>
            </Grid>

            <TabControl Margin="8" Visibility="{Binding IsRepoMissing, Converter={StaticResource InvBoolToVis}}">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}"/>
                </TabControl.Resources>

                <TabItem Header="beellama">
                    <DockPanel Margin="4,10,4,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding BeellamaUpdates}" ItemTemplate="{StaticResource UpdateTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Content="Refresh" Style="{StaticResource ModernButton}" Padding="14,4"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <ScrollViewer Style="{StaticResource StyledScrollViewer}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BeellamaOptions}" ItemTemplate="{StaticResource OptionTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="llama.cpp (Windows)">
                    <DockPanel Margin="4,10,4,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding LlamaUpdates}" ItemTemplate="{StaticResource UpdateTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Content="Refresh" Style="{StaticResource ModernButton}" Padding="14,4"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <ScrollViewer Style="{StaticResource StyledScrollViewer}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LlamaOptions}" ItemTemplate="{StaticResource OptionTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
