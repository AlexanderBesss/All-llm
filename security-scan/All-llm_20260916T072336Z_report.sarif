          "properties": {
            "severity": "low",
            "security-severity": "3.5",
            "cvssRating": "Low",
            "category": "CWE-269: Improper Privilege Management",
            "cvssVector": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:N/I:L/A:N",
            "cwe": "CWE-269 - Improper Privilege Management",
            "cweId": "CWE-269",
            "cweName": "Improper Privilege Management",
            "cvssScore": 3.5,
            "offensivePriority": "P3",
