          "ruleId": "CWE-720",
          "level": "error",
          "message": {
            "text": "settings.json repoRoot redirects script scanning to attacker directory  [CVSS 7.3: CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:H]"
          },
          "locations": [
            {
              "physicalLocation": {
