{
    "$schema": "https://opencode.ai/config.json",
    "model": "llamacpp/unsloth/Qwen3.6-27B-UD-Q4_K_XL",
    "mcp": {
        "jira": {
            "type": "remote",
            "url": "https://mcp.atlassian.com/v1/mcp/authv2",
            "enabled": true
        }
    },
    "agent": {
        "factory-jira": {
            "description": "Performs one bounded Jira MCP operation and returns its structured result.",
            "mode": "primary",
            "steps": 3,
            "prompt": "You are a bounded Jira operation agent. Use the configured Jira MCP server only. If required, make one read-only cloud/resource lookup, then make at most one requested Jira mutation. If the mutation fails, include its exact error in the structured result and stop; never repeat a failed mutation. Return exactly one JSON object matching the requested schema.",
            "permission": {
                "read": "deny",
                "edit": "deny",
                "bash": "deny",
                "glob": "deny",
                "grep": "deny",
                "list": "deny",
                "task": "deny",
                "webfetch": "deny",
                "websearch": "deny",
                "question": "deny",
                "jira_*": "allow"
            }
        }
    },
    "formatter": true,
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000
    },
    "provider": {
        "lmstudio": {
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://192.168.0.96:1234/v1",
                "apiKey": "docker"
            },
            "models": {
                "unsloth/qwen3.6-27b@q4_k_m": {
                    "name": "QWEN 3.6 27B Unsloth",
                    "repeat_penalty": 1.0,
                    "temp": 0.6,
                    "min_probability": 0,
                    "top_k": 20,
                    "presence_penalty": 0.0,
                    "top_p": 0.95,
                    "limit": {
                        "context": 128504,
                        "output": 8192
                    },
                    "cost": {
                        "input": 0.00000005,
                        "output": 0.00000027
                    },
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    }
                }
            }
        },
        "llamacpp": {
            "name": "llama.cpp (local)",
            "options": {
                "baseURL": "http://192.168.0.96:8080/v1",
                "apiKey": "docker"
            },
            "models": {
                "unsloth/Qwen3.6-27B-UD-Q4_K_XL": {
                    "name": "QWEN 3.6 27B UD-Q4_K_XL",
                    "repeat_penalty": 1.0,
                    "temp": 0.6,
                    "min_probability": 0,
                    "top_k": 20,
                    "presence_penalty": 0.0,
                    "top_p": 0.95,
                    "limit": {
                        "context": 100000,
                        "output": 8192
                    },
                    "cost": {
                        "input": 0.00000005,
                        "output": 0.00000027
                    },
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    }
                }
            }
        }
    }
}
